<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VideoConverter.ViewModels"
        xmlns:m="using:VideoConverter.Models"
        x:Class="VideoConverter.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="影片壓縮轉檔工具" Width="750" Height="580"
        WindowStartupLocation="CenterScreen">

    <TabControl Margin="10">
        <!-- 分頁 1：批量轉檔主頁 (保持原樣) -->
        <TabItem Header="轉檔主頁">
            <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" Margin="10">
                <!-- 標題與批量按鈕列 -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,10">
                    <TextBlock Grid.Column="0" Text="影音轉檔佇列" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="新增檔案" Click="OnBrowseClick" Margin="0,0,10,0"
                            Background="#007ACC" Foreground="White" FontWeight="Bold"/>
                    <Button Grid.Column="2" Content="清空列表" Command="{Binding ClearQueueCommand}" IsEnabled="{Binding !IsConverting}"/>
                </Grid>

                <!-- 輸出位置與並行數設定 -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,10">
                    <TextBlock Grid.Column="0" Text="輸出資料夾：" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding OutputFolderPath}" Watermark="預設與來源檔案相同資料夾"/>
                    <Button Grid.Column="2" Content="選擇資料夾" Click="OnBrowseFolderClick" Margin="10,0,0,0"/>
                </Grid>

                <!-- 轉換參數快速設定 -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto, Auto" Margin="0,0,0,10">
                    <TextBlock Grid.Column="0" Text="編碼器 (Codec):" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedCodecIndex}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsConverting}">
                        <ComboBoxItem>H.264 (預設 / 相容性最佳)</ComboBoxItem>
                        <ComboBoxItem>H.265 / HEVC (高壓縮率)</ComboBoxItem>
                        <ComboBoxItem>AV1 (次世代極高壓縮率)</ComboBoxItem>
                        <ComboBoxItem>自動判斷 (大檔案自動切換 H.265)</ComboBoxItem>
                    </ComboBox>
                    
                    <TextBlock Grid.Column="2" Text="同時轉檔任務數:" VerticalAlignment="Center" FontWeight="Bold" Margin="10,0,10,0"/>
                    <NumericUpDown Grid.Column="3" Value="{Binding MaxConcurrentTasks}" Minimum="1" Maximum="8" Increment="1" Width="100" IsEnabled="{Binding !IsConverting}"/>
                </Grid>

                <!-- 批量佇列清單列表 -->
                <Border Grid.Row="3" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Background="#FAFAFA" Margin="0,0,0,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ConversionQueue}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:ConversionItem">
                                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10" Background="White">
                                        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
                                            <!-- 檔名與狀態 -->
                                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,5">
                                                <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- 移除按鈕 -->
                                            <Button Grid.Row="0" Grid.Column="1" Content="❌" 
                                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveItemCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="4,2" FontSize="10"/>

                                            <!-- 獨立進度條 -->
                                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding ProgressValue}" Maximum="100" Height="12" ShowProgressText="True"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- 控制按鈕與總進度區 -->
                <Grid Grid.Row="4" ColumnDefinitions="*, Auto">
                    <TextBlock Grid.Column="0" Text="{Binding GlobalStatusMessage}" VerticalAlignment="Center" Foreground="Gray" TextWrapping="Wrap"/>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Button Content="開始全部轉檔" Command="{Binding StartQueueCommand}" 
                                IsVisible="{Binding !IsConverting}"
                                Height="38" Padding="20,0" Background="#007ACC" Foreground="White" FontWeight="Bold"/>

                        <Button Content="停止佇列轉檔" Command="{Binding CancelConversionCommand}" 
                                IsVisible="{Binding IsConverting}"
                                Height="38" Padding="20,0" Background="#D9534F" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </TabItem>

        <!-- 分頁 2：進階設定頁面 -->
        <TabItem Header="進階設定">
            <ScrollViewer>
                <StackPanel Margin="15" Spacing="15">
                    <TextBlock Text="輸出與效能設定" FontSize="18" FontWeight="Bold"/>

                    <!-- 檔名標籤設定 -->
                    <StackPanel Spacing="8">
                        <CheckBox IsChecked="{Binding EnableFileNameSuffix}" Content="輸出檔名加上自訂標籤 (FLAG)" FontWeight="Bold" IsEnabled="{Binding !IsConverting}"/>
                        <Grid ColumnDefinitions="Auto, *" IsVisible="{Binding EnableFileNameSuffix}" Margin="25,0,0,0">
                            <TextBlock Grid.Column="0" Text="標籤文字：" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" Text="{Binding FileNameSuffixText}" Watermark="例如 _compressed 或 _conv" IsEnabled="{Binding !IsConverting}"/>
                        </Grid>
                    </StackPanel>

                    <Separator Height="1" Background="#E0E0E0"/>

                    <!-- CRF 品質調整 -->
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="預設壓縮品質 (CRF):" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CrfValue}" FontWeight="Bold" Foreground="#007ACC"/>
                        </StackPanel>
                        <Slider Minimum="18" Maximum="32" Value="{Binding CrfValue}" IsSnapToTickEnabled="True" TickFrequency="1" IsEnabled="{Binding !IsConverting}"/>
                        <TextBlock Text="(數值越大體積越小，H.264建議23，H.265建議28)" Foreground="Gray" FontSize="12"/>
                    </StackPanel>

                    <Separator Height="1" Background="#E0E0E0"/>

                    <!-- 編碼速度 (Preset) -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="編碼速度 Preset (影響 CPU 占用與壓縮比):" FontWeight="Bold"/>
                        <ComboBox SelectedIndex="{Binding SelectedPresetIndex}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsConverting}">
                            <ComboBoxItem>ultrafast (最快，檔案較大)</ComboBoxItem>
                            <ComboBoxItem>fast (快速)</ComboBoxItem>
                            <ComboBoxItem>medium (平衡，預設首選)</ComboBoxItem>
                            <ComboBoxItem>slow (慢速，壓縮率較佳)</ComboBoxItem>
                            <ComboBoxItem>veryslow (極慢，最佳檔案體積)</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <Separator Height="1" Background="#E0E0E0"/>

                    <!-- 音訊設定 -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="音訊編碼速率 (Audio Bitrate):" FontWeight="Bold"/>
                        <ComboBox SelectedIndex="{Binding SelectedAudioBitrateIndex}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsConverting}">
                            <ComboBoxItem>128 kbps (標準品質)</ComboBoxItem>
                            <ComboBoxItem>192 kbps (高品質，預設)</ComboBoxItem>
                            <ComboBoxItem>320 kbps (極高音質)</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 分頁 3：關於與授權 (新增) -->
        <TabItem Header="關於">
            <ScrollViewer>
                <StackPanel Margin="20" Spacing="15">
                    <!-- 軟體名稱與版本號 -->
                    <StackPanel Spacing="5">
                <TextBlock Text="Video Converter Tool" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="{Binding AppVersionText}" FontSize="14" Foreground="#007ACC" FontWeight="Bold"/>
            </StackPanel>

                    <Separator Height="1" Background="#E0E0E0"/>

                    <!-- Apache 2.0 授權聲明 -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Application License" FontSize="16" FontWeight="Bold"/>
                        <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="This application is licensed under the Apache License, Version 2.0." FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="You may obtain a copy of the License at: http://www.apache.org/licenses/LICENSE-2.0" TextWrapping="Wrap"/>
                                <TextBlock Text="Unless required by applicable law or agreed to in writing, software distributed under the License is distributed on an &quot;AS IS&quot; BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied." Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Separator Height="1" Background="#E0E0E0"/>

                    <!-- 第三方組件與 FFmpeg 授權聲明 -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Third-Party License Notice" FontSize="16" FontWeight="Bold"/>
                        <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="• This software utilizes FFmpeg (https://ffmpeg.org), a third-party open-source multimedia framework, as its core conversion engine." TextWrapping="Wrap"/>
                                <TextBlock Text="• FFmpeg is a trademark of Fabrice Bellard and the FFmpeg development team." TextWrapping="Wrap"/>
                                <TextBlock Text="• The FFmpeg executable bundled with this package is distributed under the terms of the GNU General Public License v2.0 or later (GPL v2+)." TextWrapping="Wrap"/>
                                <TextBlock Text="• This application communicates with and invokes FFmpeg as an independent subprocess via command-line arguments (CLI)." TextWrapping="Wrap"/>
                                <TextBlock Text="• For the full license terms, please refer to LICENSE-THIRD-PARTY.md and COPYING.GPLv2 located in the application directory." TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>       
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>